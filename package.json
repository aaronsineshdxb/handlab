{
  "name": "handlab",
  "version": "0.7.0",
  "private": true,
  "description": "HANDLAB — 3D hand-tracked cursor (Next.js + React + TypeScript + Three.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
